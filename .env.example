# Server Configuration
PORT=3000
NODE_ENV=development

# PC Agent Secret Key (Must match between server and pc-agent)
AGENT_API_KEY=kiosk_secret_agent_key_2026

# Admin Credentials (Set a strong password in production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=adminpassword

# Session / JWT Secret
JWT_SECRET=super_secret_jwt_kiosk_key_change_in_production

# Storage Directories (Absolute or relative to backend)
UPLOAD_DIR=./storage/uploads
CONVERTED_DIR=./storage/converted

# Maximum Upload Size in Megabytes
MAX_FILE_SIZE_MB=25

# Payment Configuration
# Set to 'MOCK' for offline/testing, 'RAZORPAY' for real test UPI
PAYMENT_PROVIDER=MOCK
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# Printer Name configured in Fedora CUPS (e.g., 'EPSON_L3210' or 'PDF_Virtual')
PRINTER_NAME=default

